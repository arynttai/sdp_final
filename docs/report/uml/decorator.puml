@startuml
skinparam classAttributeIconSize 0
interface Meal
abstract class BaseMeal
abstract class ToppingDecorator {
  -wrapped: Meal
+price(): BigDecimal
}
class ExtraCheese
class Mushrooms
class Olives
class ToppingCatalog
Meal <|.. BaseMeal
Meal <|.. ToppingDecorator
ToppingDecorator o-- Meal : wraps
ToppingDecorator <|-- ExtraCheese
ToppingDecorator <|-- Mushrooms
ToppingDecorator <|-- Olives
ToppingCatalog ..> ToppingDecorator : constructs selected wrappers
@enduml
