@startuml
skinparam classAttributeIconSize 0
interface DiscountStrategy {
  +code(): String
+discount(Order): BigDecimal
}
class NoDiscount
class StudentDiscount
class PickupDiscount
class PricingCalculator
class Pricing <<record>>
DiscountStrategy <|.. NoDiscount
DiscountStrategy <|.. StudentDiscount
DiscountStrategy <|.. PickupDiscount
PricingCalculator --> DiscountStrategy : calculates one discount
PricingCalculator ..> Pricing : returns
@enduml
